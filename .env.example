# Legacy alpha Neon database may still support non-identity scaffolding. The
# username/PIN and caller-supplied-user snapshot endpoints are hard-disabled.
DATABASE_URL=

# Accounts & Sync V1. These are public browser configuration values; never put
# the Supabase service-role key in VITE_* variables or frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider scaffold. Phase 1/2 uses mock only.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App metadata. The frontend currently stores schemaVersion in the app state too.
APP_SCHEMA_VERSION=16

# Optional server behavior.
NOCTYRIUM_AUTO_MIGRATE=true
