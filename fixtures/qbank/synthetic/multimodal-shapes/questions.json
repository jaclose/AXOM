  "questions": [
    {
      "id": "syn-q01",
      "source": {
        "filename": "invented.pdf",
        "page": 1,
        "questionNumber": 1
      },
      "stem": [
        {
          "type": "text",
          "text": "A study follows 400 people who drink well water and 600 who drink mains water for five years. Which measure compares how often a new illness arises in the two groups?"
        }
      ],
      "choices": [
        {
          "id": "syn-q01-a",
          "label": "A",
          "blocks": [
            {
              "type": "text",
              "text": "Prevalence ratio"
            }
          ]
        },
        {
          "id": "syn-q01-b",
          "label": "B",
          "blocks": [
            {
              "type": "text",
              "text": "Relative risk"
            }
          ]
        },
        {
          "id": "syn-q01-c",
          "label": "C",
          "blocks": [
            {
              "type": "text",
              "text": "Odds of exposure"
            }
          ]
        },
        {
          "id": "syn-q01-d",
          "label": "D",
          "blocks": [
            {
              "type": "text",
              "text": "Case fatality"
            }
          ]
        },
        {
          "id": "syn-q01-e",
          "label": "E",
          "blocks": [
            {
              "type": "text",
              "text": "Specificity"
            }
          ]
        }
      ],
      "correctAnswer": {
        "labels": ["B"],
        "evidence": "printed-key"
      },
      "explanation": [
        {
          "type": "text",
          "text": "Both groups are followed forward from the exposure, so the two incidences can be measured and divided."
        }
      ],
      "assets": [],
      "provenance": {
        "method": "authored",
        "notes": "Invented for tests. Not course material."
      }
    },
    {
      "id": "syn-q02",
      "source": {
        "filename": "invented.pdf",
        "page": 1,
        "questionNumber": 2
      },
      "stem": [
        {
          "type": "text",
          "text": "Investigators compare 200 gardeners who use a compost additive with 300 who do not, and record who develops a rash within a year."
        },
        {
          "type": "table",
          "headers": ["", "Rash", "No rash", "Total"],
          "rowHeaders": true,
          "rows": [
            ["Additive", "40", "160", "200"],
            ["No additive", "30", "270", "300"],
            ["Total", "70", "430", "500"]
          ]
        },
        {
          "type": "text",
          "text": "What is the relative risk of a rash in gardeners who use the additive?"
        }
      ],
      "choices": [
        {
          "id": "syn-q02-a",
          "label": "A",
          "blocks": [
            {
              "type": "text",
              "text": "0.5"
            }
          ]
        },
        {
          "id": "syn-q02-b",
          "label": "B",
          "blocks": [
            {
              "type": "text",
              "text": "1.0"
            }
          ]
        },
        {
          "id": "syn-q02-c",
          "label": "C",
          "blocks": [
            {
              "type": "text",
              "text": "2.0"
            }
          ]
        },
        {
          "id": "syn-q02-d",
          "label": "D",
          "blocks": [
            {
              "type": "text",
              "text": "2.5"
            }
          ]
        },
        {
          "id": "syn-q02-e",
          "label": "E",
          "blocks": [
            {
              "type": "text",
              "text": "4.0"
            }
          ]
        }
      ],
      "correctAnswer": {
        "labels": ["C"],
        "evidence": "printed-key"
      },
      "explanation": [
        {
          "type": "text",
          "text": "Divide the risk in the exposed group by the risk in the unexposed group."
        },
        {
          "type": "equation",
          "latex": "RR = \\frac{40 / 200}{30 / 300} = 2.0",
          "plainText": "RR = (40 / 200) / (30 / 300) = 2.0"
        }
      ],
      "assets": [],
      "provenance": {
        "method": "authored",
        "notes": "Invented for tests. Not course material."
      }
    },
