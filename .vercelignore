# Keep Vercel uploads focused on the deployable web app.
/*
!/api
!/api/**
!/lib
!/lib/**
!/db
!/db/**
!/package.json
!/package-lock.json
!/vercel.json
!/.env.example
!/web
!/web/**

# Heavy/local artifacts inside web.
web/node_modules
web/dist
web/Noctyrium-*.zip
web/Noctyrium.app
web/tsconfig.tsbuildinfo
**/.DS_Store

# Shared release metadata required by the web build.
!/CHANGELOG.md
!/scripts/
!/scripts/release-notes.mjs
!/scripts/release-notes.d.mts

# Shared Supabase AI proxy core used by web TypeScript tests.
!/supabase/
!/supabase/functions/
!/supabase/functions/ai-proxy/
!/supabase/functions/ai-proxy/core.ts

# AXOM GOER manifest allowlist
!/fixtures/
/fixtures/*
!/fixtures/qbank/
/fixtures/qbank/*
!/fixtures/qbank/goer/
/fixtures/qbank/goer/*
!/fixtures/qbank/goer/t5/
/fixtures/qbank/goer/t5/*
!/fixtures/qbank/goer/t5/week-02/
/fixtures/qbank/goer/t5/week-02/*
!/fixtures/qbank/goer/t5/week-02/*/
/fixtures/qbank/goer/t5/week-02/*/*
!/fixtures/qbank/goer/t5/week-02/*/manifest.json
