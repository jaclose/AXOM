# Keep Vercel uploads focused on the deployable web app.
/*
!/api
!/api/**
!/lib
!/lib/**
!/db
!/db/**
!/package.json
!/package-lock.json
!/vercel.json
!/.env.example
!/web
!/web/**

# Heavy/local artifacts inside web.
web/node_modules
web/dist
web/Noctyrium-*.zip
web/Noctyrium.app
web/tsconfig.tsbuildinfo
**/.DS_Store

# Shared release metadata required by the web build.
!/CHANGELOG.md
!/scripts/
!/scripts/release-notes.mjs
!/scripts/release-notes.d.mts

# Edge Function logic the web tests import; `tsc -b` in the build type-checks
# them, so without it every deployment fails with TS2307. Migrations, config
# and email templates stay out of the upload.
!/supabase/
/supabase/*
!/supabase/functions/
