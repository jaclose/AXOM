{
  "name": "axom-cloud",
  "private": true,
  "version": "0.0.2-prebeta",
  "type": "module",
  "description": "Optional Vercel serverless backend for AXOM cloud sync and AI scaffolding.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npx vercel dev",
    "web:dev": "npm --prefix web run dev",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "release": "node scripts/release.mjs",
    "release:doctor": "node scripts/release.mjs --doctor",
    "release:setup-updater": "node scripts/setup-updater.mjs",
    "release:web": "node scripts/release.mjs --web-only",
    "release:version": "node scripts/release.mjs --version",
    "test:release": "node --test scripts/*.test.mjs",
    "icon": "node scripts/render-app-icon.mjs",
    "cinematic:import": "node scripts/import-cinematic.mjs",
    "typecheck:api": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node lib/api/*.ts api/*.ts",
    "db:migration": "cat db/migrations/001_initial.sql",
    "schools:validate": "node --experimental-strip-types web/scripts/application-school-pipeline.mjs validate",
    "schools:merge": "node --experimental-strip-types web/scripts/application-school-pipeline.mjs merge",
    "schools:diff": "node --experimental-strip-types web/scripts/application-school-pipeline.mjs diff",
    "wdio": "wdio run ./wdio.conf.ts",
    "audit:site": "wdio run ./wdio.conf.ts --spec ./test/specs/axom.audit.e2e.ts",
    "audit:open": "open artifacts/site-audit/report.md",
    "audit:folder": "open artifacts/site-audit",
    "audit:full": "wdio run ./wdio.conf.ts --spec ./test/specs/axom.full-audit.e2e.ts",
    "audit:full:open": "open artifacts/site-audit-v2/report.md",
    "audit:full:folder": "open artifacts/site-audit-v2",
    "audit:beta": "wdio run ./wdio.conf.ts --spec ./test/specs/axom.beta-audit.e2e.ts",
    "audit:beta:open": "open artifacts/beta-audit-v3/report.md",
    "audit:beta:folder": "open artifacts/beta-audit-v3",
    "residency:import": "node --experimental-strip-types web/scripts/residency-pipeline.mjs import",
    "residency:validate": "node --experimental-strip-types web/scripts/residency-pipeline.mjs validate",
    "test:accounts:live": "npm --prefix web run test:accounts:live"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.20.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "expect-webdriverio": "^5.7.0",
    "supabase": "^2.118.0",
    "typescript": "^5.6.3"
  }
}
